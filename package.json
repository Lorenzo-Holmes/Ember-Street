{
  "name": "ember-street",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:codespaces": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui-smoke": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "audit:assets": "node scripts/audit-visual-assets.mjs",
    "audit:assets:strict": "node scripts/audit-visual-assets.mjs --strict",
    "preview": "vite preview",
    "cf:dry-run": "npm run build && wrangler deploy --dry-run",
    "deploy:cf": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.1"
  }
}
